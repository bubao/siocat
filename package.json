{
  "name": "siocat",
  "version": "1.0.0",
  "description": "A human-friendly TUI client for Socket.IO, similar to wscat but with support for multiple Socket.IO protocol versions",
  "main": "bin/siocat.js",
  "bin": {
    "siocat": "bin/siocat.js"
  },
  "scripts": {
    "start": "node bin/siocat.js",
    "test-server": "node test/server.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
    "socket.io",
    "websocket",
    "tui",
    "cli",
    "client"
  ],
  "author": "Developer",
  "license": "MIT",
  "dependencies": {
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^11.0.0",
    "json5": "^2.2.3",
    "socket.io-client": "^4.8.1",
    "socket.io-client-2": "npm:socket.io-client@^2.5.0",
    "socket.io-client-3": "npm:socket.io-client@^3.1.3",
    "socket.io-client-4": "npm:socket.io-client@^4.8.1"
  },
  "devDependencies": {
    "express": "^4.22.1",
    "jest": "^29.6.2",
    "socket.io": "^4.8.1"
  },
  "engines": {
    "node": ">=12.0.0"
  }
}
