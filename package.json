    "commander": "^11.0.0",
    "json5": "^2.2.3",
    "socket.io-client": "^4.8.1",
    "socket.io-client-2": "npm:socket.io-client@^2.5.0",
    "socket.io-client-3": "npm:socket.io-client@^3.1.3",
    "socket.io-client-4": "npm:socket.io-client@^4.8.1"
  },
  "devDependencies": {
    "express": "^4.22.1",
    "jest": "^29.6.2",
