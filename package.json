  "description": "A human-friendly TUI & CLI client for Socket.IO with multi-protocol support (v2, v3, v4)",
  "main": "bin/siocat.js",
  "bin": {
    "siocat": "bin/siocat.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bubao/siocat.git"
  },
  "bugs": {
    "url": "https://github.com/bubao/siocat/issues"
  },
  "homepage": "https://github.com/bubao/siocat#readme",
  "scripts": {
    "start": "node bin/siocat.js",
    "test-server": "node mock-server/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:coverage": "jest --runInBand --detectOpenHandles --coverage"
  },
  "keywords": [
    "socket.io",
    "websocket",
    "tui",
    "cli",
